# PostgreSQL clubs-service database (created in pgAdmin as sportmatch_clubs).
# Do not commit a real password. From Docker use DB_HOST=host.docker.internal.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sportmatch_clubs
DB_PASSWORD=
DB_NAME=sportmatch_clubs

# Access tokens are signed by Ms_Users: use the same values it has.
JWT_SECRET=
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile

# Ms_Users, to attach the athlete's sports profile to a postulación (HU-33).
# From Docker Compose: http://ms_users:8001
USERS_SERVICE_URL=http://127.0.0.1:8001
USERS_TIMEOUT_SECONDS=10

# Administrators per club, counting pending email assignments (3 to 100).
CLUB_MAX_ADMINS=10

# Hourly check of inactive club channels (G4); false turns it off.
CANALES_INACTIVIDAD_ENABLED=true
