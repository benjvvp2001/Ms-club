# PostgreSQL clubs-service database (created in pgAdmin as sportmatch_clubs).
# Do not commit a real password. From Docker use DB_HOST=host.docker.internal.
DB_HOST=localhost
DB_PORT=5432
DB_USER=sportmatch_clubs
DB_PASSWORD=
DB_NAME=sportmatch_clubs

# Access tokens are signed by Ms_Users: use the same values it has.
JWT_SECRET=
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile

# Ms_Users, to attach the athlete's sports profile to a postulación (HU-33).
# From Docker Compose: http://ms_users:8001
USERS_SERVICE_URL=http://127.0.0.1:8001
USERS_TIMEOUT_SECONDS=10

# Administrators per club, counting pending email assignments (3 to 100).
CLUB_MAX_ADMINS=10

# Webpay Plus (HU-40). Plan payments.
# WEBPAY_MOCK_MODE=true simulates Webpay with a page served by this service:
# nothing is charged and whatever the person clicks is approved. Local
# development only; the service refuses it with WEBPAY_ENVIRONMENT=PRODUCTION.
WEBPAY_MOCK_MODE=false
# INTEGRATION uses Transbank's public test credentials when the two below are
# left empty. PRODUCTION requires your own commerce code and API key.
WEBPAY_ENVIRONMENT=INTEGRATION
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# This service as the user's browser reaches it (through the gateway). Webpay
# sends the browser back to {WEBPAY_PUBLIC_URL}/api/v1/payments/webpay/return.
WEBPAY_PUBLIC_URL=http://127.0.0.1:8004
# Where that endpoint finally sends the user: a page of the web app or the
# app's deep link (scheme sportmatchapp). It receives the token as query params.
WEBPAY_FRONTEND_RETURN_URL=sportmatchapp://pago
WEBPAY_TIMEOUT_SECONDS=15
